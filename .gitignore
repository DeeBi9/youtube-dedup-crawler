# Environment — contains secret YT_API_KEY
.env

# Python bytecode — build artifacts, never part of source
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Test & coverage artifacts — generated by test runs
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Database files — user data generated at runtime
crawler.db
*.sqlite
*.sqlite3

# Virtual environments — machine-local, not portable
.venv/
venv/

# IDE metadata — personal editor config
.idea/
.vscode/
